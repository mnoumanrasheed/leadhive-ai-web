{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/auth(?<path>/.*)?$",
      "dest": "https://8qgnw9pl-8002.inc1.devtunnels.ms/auth$path",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tunnel-Skip-AntiPhishing-Page"
          },
          "args": "true"
        }
      ]
    },
    {
