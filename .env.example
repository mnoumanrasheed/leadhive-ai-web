# Server-only development proxy target. Do not prefix this variable with VITE_.
BACKEND_URL=https://api.example.com

# Public Google reCAPTCHA v2 Checkbox site key. Vite embeds only this value in
# the browser bundle; never put RECAPTCHA_SECRET_KEY in a VITE_ variable.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_checkbox_site_key
